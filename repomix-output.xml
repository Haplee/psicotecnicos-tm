  { id: 'espacial', number: '03', title: 'Aptitud espacial', short: 'Espacial', description: 'Rotaciones, cubos, plegado y visualización tridimensional.', icon: 'box', accent: 'wine' },
  { id: 'mecanica', number: '04', title: 'Aptitud mecánica', short: 'Mecánica', description: 'Palancas, poleas, engranajes, fuerzas y movimiento.', icon: 'cog', accent: 'wine' },
