.settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }.settings-section { padding: 18px; }.settings-section-heading { display: flex; align-items: flex-start; gap: 11px; margin-bottom: 17px; }.settings-icon { width: 36px; height: 36px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 9px; background: rgba(113, 52, 72, .17); color: var(--wine-soft); }.settings-section-heading h3 { margin: 1px 0 5px; font-size: 12px; }.settings-section-heading p { margin: 0; color: var(--muted); font-size: 9px; line-height: 1.6; }.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 13px; padding: 12px 0; border-top: 1px solid var(--border); }.setting-row > span { display: grid; gap: 4px; }.setting-row strong { font-size: 10px; }.setting-row small { color: var(--muted); font-size: 9px; }.setting-row select { min-width: 124px; padding: 8px 10px; border: 1px solid var(--border-strong); border-radius: 7px; color: var(--text); background: var(--surface-2); font-size: 10px; }.theme-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }.theme-choice { min-height: 83px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 5px; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--muted-2); text-align: left; }.theme-choice.selected { border-color: var(--wine-soft); color: var(--text); background: rgba(113, 52, 72, .12); }.theme-choice svg { color: var(--wine-soft); }.theme-choice strong { font-size: 10px; }.theme-choice small { font-size: 9px; color: var(--muted); }.backup-actions { display: flex; flex-wrap: wrap; gap: 8px; }.upload-button { position: relative; overflow: hidden; cursor: pointer; }.upload-button input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }.inline-feedback { margin-top: 12px; padding: 9px 10px; border-radius: 7px; display: flex; gap: 8px; align-items: center; background: var(--surface-2); color: var(--muted-2); font-size: 9px; }.setting-footnote { margin-top: 12px; color: var(--muted); font-size: 9px; line-height: 1.55; }.danger-section { border-color: rgba(220, 130, 141, .23); }.danger-icon { background: rgba(220, 130, 141, .1); color: var(--bad); }.confirm-reset { padding: 12px; border-radius: 8px; background: rgba(220, 130, 141, .07); }.confirm-reset strong { font-size: 10px; }.confirm-reset div { display: flex; gap: 8px; margin-top: 11px; }

.exam-area { margin-left: 0; }.exam-screen { min-height: 100vh; }.exam-topbar { height: 68px; position: sticky; top: 0; z-index: 25; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 0 28px; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 94%, transparent); backdrop-filter: blur(16px); }.exam-top-left, .exam-top-right { display: flex; align-items: center; gap: 13px; }.brand-lockup.compact { padding: 0; }.brand-lockup.compact .brand-mark { width: 34px; height: 34px; border-radius: 9px; font-size: 12px; }.brand-lockup.compact .brand-copy strong { font-size: 10px; }.brand-lockup.compact .brand-copy span { font-size: 8px; }.exam-progress-top { min-width: 125px; display: grid; gap: 5px; color: var(--muted); font-size: 9px; }.top-progress-track { height: 4px; background: var(--surface-3); border-radius: 5px; overflow: hidden; }.top-progress-track span { height: 100%; display: block; background: var(--wine-soft); border-radius: inherit; }.timer-chip { min-width: 86px; height: 35px; padding: 0 10px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface-2); color: var(--text); font-variant-numeric: tabular-nums; }.timer-chip svg { color: var(--wine-soft); }.timer-chip strong { font-size: 12px; letter-spacing: .05em; }.timer-chip.timer-warning { border-color: rgba(220, 130, 141, .55); color: var(--bad); background: rgba(220, 130, 141, .09); }.timer-chip.timer-warning svg { color: var(--bad); }.exam-content { width: min(100%, 1050px); padding: 28px 28px 60px; margin: 0 auto; }.exam-intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 19px; }.exam-intro h1 { margin: 7px 0 5px; font-size: 25px; letter-spacing: -.045em; }.exam-intro p { max-width: 650px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.6; }.exam-summary-box { min-width: 86px; padding: 10px 12px; text-align: center; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); }.exam-summary-box strong { display: block; font-size: 19px; font-variant-numeric: tabular-nums; }.exam-summary-box strong span { color: var(--muted); font-size: 12px; }.exam-summary-box small { color: var(--muted); font-size: 8px; }.question-jump { display: flex; align-items: flex-start; gap: 11px; padding: 12px; margin-bottom: 17px; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); }.question-jump > span { padding-top: 5px; color: var(--muted); font-size: 8px; font-weight: 750; letter-spacing: .12em; white-space: nowrap; }.jump-list { display: flex; flex-wrap: wrap; gap: 5px; }.jump-list a { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 6px; border: 1px solid var(--border); color: var(--muted); text-decoration: none; font-size: 8px; }.jump-list a:hover { border-color: var(--wine-soft); color: var(--text); }.jump-list a.done { border-color: rgba(167, 121, 137, .5); color: var(--wine-pale); background: rgba(113, 52, 72, .26); }
.exam-group { margin-top: 27px; }.exam-group-heading { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; padding: 0 0 10px; border-bottom: 1px solid var(--border); }.exam-group-heading > span { width: 34px; height: 34px; display: grid; place-items: center; background: var(--wine); color: #fff; border-radius: 8px; font-size: 10px; font-weight: 750; }.exam-group-heading h2 { margin: 0 0 3px; font-size: 14px; }.exam-group-heading small { color: var(--muted); font-size: 9px; }
.questions-list { display: grid; gap: 11px; }.question-card { min-width: 0; padding: 16px 17px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); scroll-margin-top: 90px; }.question-heading { display: flex; align-items: center; gap: 9px; }.question-number { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 6px; background: var(--surface-3); color: var(--wine-pale); font-size: 9px; font-weight: 750; }.question-meta { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 8px; }.dot-separator { color: var(--border-strong); }.question-prompt { margin: 12px 0 14px; font-size: 12px; font-weight: 620; line-height: 1.55; letter-spacing: -.01em; }.answer-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }.answer-option { min-height: 40px; display: flex; align-items: center; gap: 10px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface-2); color: var(--muted-2); cursor: pointer; transition: .15s; }.answer-option:hover { border-color: var(--border-strong); background: var(--surface-3); color: var(--text); }.answer-option input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }.option-letter { width: 23px; height: 23px; flex: 0 0 auto; display: grid; place-items: center; border: 1px solid var(--border-strong); border-radius: 5px; color: var(--muted); font-size: 8px; font-weight: 750; }.option-text { flex: 1; font-size: 10px; line-height: 1.4; }.answer-option.selected { color: var(--text); background: rgba(113, 52, 72, .2); border-color: var(--wine-soft); }.answer-option.selected .option-letter { color: #fff; background: var(--wine); border-color: var(--wine); }.answer-option.readonly { cursor: default; }.answer-option.answer-correct { border-color: rgba(119, 180, 155, .65); background: rgba(119, 180, 155, .1); color: var(--text); }.answer-option.answer-correct .option-letter { color: #fff; background: #36775d; border-color: #36775d; }.answer-option.answer-wrong { border-color: rgba(220, 130, 141, .65); background: rgba(220, 130, 141, .09); }.answer-option.answer-wrong .option-letter { color: #fff; background: #843c4b; border-color: #843c4b; }.option-status { color: var(--good); }.answer-wrong .option-status { color: var(--bad); }
.result-pill { margin-left: auto; padding: 4px 7px; border-radius: 30px; font-size: 8px; font-weight: 700; }.result-pill.good { color: var(--good); background: rgba(119, 180, 155, .12); }.result-pill.bad { color: var(--bad); background: rgba(220, 130, 141, .12); }.result-pill.neutral { color: var(--muted); background: var(--surface-3); }.question-correct { border-color: rgba(119, 180, 155, .26); }.question-incorrect { border-color: rgba(220, 130, 141, .27); }.answer-explanation { margin-top: 13px; padding: 12px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface-2); }.explanation-title { display: flex; align-items: center; gap: 7px; color: var(--good); font-size: 9px; font-weight: 750; }.answer-explanation p { margin: 8px 0; color: var(--muted-2); font-size: 10px; line-height: 1.65; }.tip-box { padding: 8px 10px; border-left: 2px solid var(--wine-soft); background: rgba(113, 52, 72, .1); color: var(--muted); font-size: 9px; line-height: 1.6; }.tip-box strong { color: var(--wine-pale); }
.diagram-wrap { width: min(100%, 440px); margin: 6px 0 14px; padding: 9px 12px 7px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); }.diagram-svg { width: 100%; height: auto; max-height: 165px; display: block; }.diagram-caption { display: block; margin-top: 4px; color: var(--muted); text-align: center; font-size: 8px; }.symbol-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; min-height: 64px; align-items: center; color: var(--wine-pale); font-size: 27px; }
.submit-panel { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 25px; padding: 17px; border: 1px solid var(--border-strong); border-radius: 10px; background: var(--surface); }.submit-panel > div { display: grid; gap: 5px; }.submit-panel strong { font-size: 11px; }.submit-panel span { color: var(--muted); font-size: 9px; }.exam-disclaimer { margin-top: 15px; color: var(--muted); font-size: 8px; text-align: center; }
.memory-screen { min-height: 100vh; }.memory-content { width: min(100% - 36px, 690px); margin: 42px auto 60px; display: flex; flex-direction: column; align-items: center; text-align: center; }.memory-icon { width: 56px; height: 56px; display: grid; place-items: center; border-radius: 15px; background: rgba(113, 52, 72, .2); color: var(--wine-soft); border: 1px solid rgba(167, 121, 137, .27); margin-bottom: 17px; }.memory-content h1 { margin: 8px 0; font-size: 27px; letter-spacing: -.045em; }.memory-instruction { max-width: 550px; margin: 0; color: var(--muted); font-size: 11px; line-height: 1.7; }.memory-time { display: flex; align-items: center; gap: 9px; margin: 22px 0 13px; padding: 9px 13px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--muted); font-size: 9px; }.memory-time svg { color: var(--wine-soft); }.memory-time strong { color: var(--text); font-size: 12px; font-variant-numeric: tabular-nums; }.memory-brief { width: 100%; border: 1px solid var(--border-strong); border-radius: 11px; background: var(--surface); text-align: left; overflow: hidden; }.brief-header { display: flex; align-items: center; gap: 9px; padding: 12px 15px; background: var(--surface-2); border-bottom: 1px solid var(--border); color: var(--wine-soft); }.brief-header strong { color: var(--text); font-size: 9px; letter-spacing: .1em; }.brief-header span { margin-left: auto; color: var(--muted); font-size: 8px; letter-spacing: .1em; }.memory-brief pre { margin: 0; padding: 20px 23px; white-space: pre-wrap; color: var(--muted-2); font: 11px/1.85 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }.memory-start { margin-top: 17px; min-width: min(100%, 340px); }.memory-footnote { margin-top: 9px; color: var(--muted); font-size: 8px; }

.results-page { max-width: 1180px; }.result-hero { min-height: 160px; display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 25px 30px; border: 1px solid rgba(167, 121, 137, .36); border-radius: 13px; background: radial-gradient(ellipse at 84% 50%, rgba(113, 52, 72, .2), transparent 45%), var(--surface); }.result-hero h2 { margin: 8px 0 5px; font-size: 24px; letter-spacing: -.045em; }.result-hero p { margin: 0; color: var(--muted); font-size: 9px; }.score-ring { width: 112px; height: 112px; flex: 0 0 auto; padding: 8px; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--wine-soft) var(--score), var(--surface-3) 0); }.score-ring > div { width: 100%; height: 100%; border-radius: 50%; background: var(--surface); display: grid; align-content: center; justify-items: center; gap: 2px; }.score-ring strong { font-size: 21px; letter-spacing: -.05em; }.score-ring span { color: var(--muted); font-size: 8px; }.result-metrics { margin: 13px 0 25px; }.result-toolbar { align-items: center; margin-bottom: 13px; }.result-toolbar h3 { font-size: 14px; }.result-toolbar p { margin: 5px 0 0; color: var(--muted); font-size: 9px; }.result-actions { display: flex; gap: 7px; }.filter-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--border); margin-bottom: 13px; }.filter-tabs button { padding: 9px 12px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font-size: 9px; }.filter-tabs button.active { border-color: var(--wine-soft); color: var(--wine-pale); }.result-questions { gap: 10px; }.result-bottom-actions { display: flex; justify-content: space-between; gap: 10px; padding-top: 18px; }

