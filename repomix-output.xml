// Banco original de entrenamiento. No contiene preguntas oficiales del Ministerio de Defensa.
export type AptitudeId = 'verbal' | 'numerica' | 'espacial' | 'mecanica' | 'perceptiva' | 'memoria' | 'abstracta'
export type VisualKind = 'cube-net' | 'lever' | 'pulley' | 'gears' | 'matrix' | 'sequence' | 'symbol-grid' | 'shading-sequence'

export interface Question {
  id: string
  aptitudeId: AptitudeId
  prompt: string
  options: [string, string, string, string]
  answer: number
  explanation: string
  tip: string
  difficulty: 'Básico' | 'Intermedio' | 'Avanzado'
  topic: string
  visual?: VisualKind
}

export interface Aptitude {
  id: AptitudeId
  number: string
  title: string
  short: string
  description: string
  icon: string
  accent: string
  memoryBrief?: string
}

